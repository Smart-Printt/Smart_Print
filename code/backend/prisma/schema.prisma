// SmartPrint - Backend Phase 1 database schema
// FIFO printing queue is ordered by Queue.queueNumber (see FIFO note on the Queue model).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  FACULTY
  SHOP_STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PLACED
  PAYMENT_CONFIRMED
  QUEUED
  PRINTING
  READY
  COLLECTED
  CANCELLED
}

enum PrintType {
  BW
  COLOR
}

enum PaperSize {
  A4
  A3
  A5
  LETTER
  LEGAL
}

enum Sides {
  SINGLE
  DOUBLE
}

enum FinishingType {
  SPIRAL_BINDING
  HARD_BINDING
  STAPLING
  LAMINATION
  NONE
}

enum QueueStatus {
  WAITING
  PRINTING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  WALLET
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RefundStatus {
  REQUESTED
  PROCESSED
  FAILED
}

// Normalized, application-level document type - not a raw file extension.
// New formats can be added here without touching unrelated code, since
// upload validation/processing is driven off this same identifier (see
// src/config/documentTypes.ts).
enum DocumentFileType {
  PDF
  DOC
  DOCX
  XLS
  XLSX
  PPT
  PPTX
  JPG
  PNG
}

// ─────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────

model User {
  userId       String     @id @default(uuid()) @map("user_id")
  name         String
  email        String     @unique
  phone        String?
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  // Only ever set for role=SHOP_STAFF - see the CHECK constraint added in
  // the phase8_shop_staff migration (STUDENT/ADMIN rows must keep this
  // null). Nullable rather than required so a SHOP_STAFF account can exist
  // between creation and shop assignment; the admin staff endpoints
  // require it explicitly at creation time (see staff.service.ts).
  shopId       String?    @map("shop_id")

  // onDelete: Restrict - a shop with assigned staff can never be deleted
  // out from under them (staff must be reassigned/unassigned first). This
  // project never exposes a shop-delete endpoint anyway; this is a
  // defensive DB-level guarantee, not a route requirement.
  shop                PrintShop?           @relation(fields: [shopId], references: [shopId], onDelete: Restrict, onUpdate: Cascade)
  documents           Document[]
  orders              Order[]
  orderStatusChanges  OrderStatusHistory[] @relation("OrderStatusChangedBy")
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([shopId])
  @@map("users")
}

// One-time password reset tokens. Only a SHA-256 hash of the raw token is
// ever stored here - the raw token exists only transiently (in memory, in
// the generated reset URL, and in the user's email); see
// utils/passwordResetToken.ts. A token is valid only while usedAt IS NULL
// and expiresAt is in the future (see auth.service.ts::resetPassword).
model PasswordResetToken {
  tokenId   String    @id @default(uuid()) @map("token_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Document {
  documentId String           @id @default(uuid()) @map("document_id")
  userId     String           @map("user_id")
  fileName   String           @map("file_name")
  fileUrl    String           @map("file_url")
  // Internal storage identifier (a generated filename under UPLOAD_DIR) -
  // never the original filename and never a client-supplied path.
  storageKey String           @unique @map("storage_key")
  fileType   DocumentFileType @map("file_type")
  mimeType   String           @map("mime_type")
  fileSize   Int              @map("file_size")
  // SHA-256 hex digest. Intentionally NOT unique: two different users may
  // legitimately upload byte-identical files.
  fileHash   String           @map("file_hash")
  // Nullable: some formats (XLSX, legacy DOC/XLS/PPT, and DOCX without a
  // cached Word page count) cannot be given a reliable printable page count
  // without full layout rendering - see src/services/documents/processors.
  // This is distinct from the future OrderDocument.printPageCount, which
  // will reflect order-time print settings rather than the source document.
  pageCount  Int?             @map("page_count")
  uploadedAt DateTime         @default(now()) @map("uploaded_at")

  user           User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  orderDocuments OrderDocument[]

  @@index([userId])
  @@index([fileHash])
  @@map("documents")
}

model PrintShop {
  shopId          String   @id @default(uuid()) @map("shop_id")
  shopCode        String   @unique @map("shop_code")
  shopName        String   @map("shop_name")
  location        String
  contact         String
  isActive        Boolean  @default(true) @map("is_active")
  acceptingOrders Boolean  @default(true) @map("accepting_orders")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  orders         Order[]
  pricingRules   ShopPricingRule[]
  finishingRules ShopFinishingRule[]
  staff          User[]

  @@map("print_shops")
}

model Order {
  orderId         String      @id @default(uuid()) @map("order_id")
  orderCode       String      @unique @map("order_code")
  userId          String      @map("user_id")
  shopId          String      @map("shop_id")
  orderStatus     OrderStatus @default(PLACED) @map("order_status")
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  cancelledAt     DateTime?   @map("cancelled_at")
  cancelledReason String?     @map("cancelled_reason")

  user           User                 @relation(fields: [userId], references: [userId])
  shop           PrintShop            @relation(fields: [shopId], references: [shopId])
  orderDocuments OrderDocument[]
  queue          Queue?
  payments       Payment[]
  statusHistory  OrderStatusHistory[]

  @@index([userId])
  @@index([shopId])
  @@index([orderStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderDocument {
  orderDocumentId     String  @id @default(uuid()) @map("order_document_id")
  orderId             String  @map("order_id")
  documentId          String  @map("document_id")
  pricingRuleId       String  @map("pricing_rule_id")
  finishingRuleId     String? @map("finishing_rule_id")
  copies              Int
  printPageCount      Int     @map("print_page_count")
  // Original page-selection string as submitted (e.g. "1-5,8,10-12").
  // NULL means "the entire document". Kept for display/audit; the
  // authoritative resolved count is printPageCount.
  pageRange           String? @map("page_range")
  specialInstructions String? @map("special_instructions")

  // Snapshot fields: preserve the price at the time the order was placed,
  // independent of later changes to ShopPricingRule / ShopFinishingRule.
  pricePerPage   Decimal @map("price_per_page") @db.Decimal(10, 2)
  finishingPrice Decimal @map("finishing_price") @db.Decimal(10, 2)
  lineTotal      Decimal @map("line_total") @db.Decimal(10, 2)

  order         Order              @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  document      Document           @relation(fields: [documentId], references: [documentId])
  pricingRule   ShopPricingRule    @relation(fields: [pricingRuleId], references: [pricingRuleId])
  finishingRule ShopFinishingRule? @relation(fields: [finishingRuleId], references: [finishingRuleId])

  @@index([orderId])
  @@index([documentId])
  @@index([pricingRuleId])
  @@index([finishingRuleId])
  @@map("order_documents")
}

model ShopPricingRule {
  pricingRuleId String    @id @default(uuid()) @map("pricing_rule_id")
  shopId        String    @map("shop_id")
  printType     PrintType @map("print_type")
  paperSize     PaperSize @map("paper_size")
  sides         Sides
  pricePerPage  Decimal   @map("price_per_page") @db.Decimal(10, 2)
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  shop           PrintShop       @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  orderDocuments OrderDocument[]

  @@index([shopId])
  // A given (shop, printType, paperSize, sides) combination may legitimately
  // have several rows over time (different effectiveFrom - see
  // pricing.service.ts's overlap-prevention, which allows sequential,
  // non-overlapping periods for the same combination). What must never
  // happen is two IDENTICAL rows (down to effectiveFrom) - that's a data
  // duplication bug (e.g. re-running a non-idempotent seed), not a
  // legitimate repricing. This also serves as the lookup index the overlap
  // check and order-time resolution query already relied on.
  @@unique([shopId, printType, paperSize, sides, effectiveFrom])
  @@map("shop_pricing_rules")
}

model ShopFinishingRule {
  finishingRuleId String        @id @default(uuid()) @map("finishing_rule_id")
  shopId          String        @map("shop_id")
  finishingType   FinishingType @map("finishing_type")
  price           Decimal       @db.Decimal(10, 2)
  isActive        Boolean       @default(true) @map("is_active")
  effectiveFrom   DateTime      @map("effective_from")
  effectiveTo     DateTime?     @map("effective_to")

  shop           PrintShop       @relation(fields: [shopId], references: [shopId], onDelete: Cascade)
  orderDocuments OrderDocument[]

  @@index([shopId])
  // Same rationale as ShopPricingRule above: multiple rows for the same
  // (shop, finishingType) are fine across different effectiveFrom periods,
  // but an identical row twice is always a duplication bug.
  @@unique([shopId, finishingType, effectiveFrom])
  @@map("shop_finishing_rules")
}

// FIFO queue: WAITING entries are retrieved ordered by queue_number ASC (then
// queue_id as a last-resort tie-break). queue_number is allocated as max + 1
// per shop while the shop row is locked, so it is exactly the order in which
// entries were serialized. entered_at is an application-clock timestamp
// (millisecond resolution; it can tie or step backwards) kept for display and
// audit - it does not decide order. No priority score / weighting fields exist.
model Queue {
  queueId     String      @id @default(uuid()) @map("queue_id")
  orderId     String      @unique @map("order_id")
  queueNumber Int         @map("queue_number")
  queueStatus QueueStatus @default(WAITING) @map("queue_status")
  enteredAt   DateTime    @default(now()) @map("entered_at")
  startedAt   DateTime?   @map("started_at")
  completedAt DateTime?   @map("completed_at")
  cancelledAt DateTime?   @map("cancelled_at")

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([enteredAt])
  @@index([queueStatus])
  // Supports listing WAITING entries by arrival time (display/audit); FIFO order itself is by queue_number.
  @@index([queueStatus, enteredAt])
  @@map("queue")
}

model Payment {
  paymentId     String        @id @default(uuid()) @map("payment_id")
  orderId       String        @map("order_id")
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  transactionId String        @unique @map("transaction_id")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  paidAt        DateTime?     @map("paid_at")

  order   Order    @relation(fields: [orderId], references: [orderId])
  refunds Refund[]

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
}

model Refund {
  refundId            String       @id @default(uuid()) @map("refund_id")
  paymentId           String       @map("payment_id")
  refundAmount        Decimal      @map("refund_amount") @db.Decimal(10, 2)
  refundReason        String       @map("refund_reason")
  refundStatus        RefundStatus @default(REQUESTED) @map("refund_status")
  refundTransactionId String       @unique @map("refund_transaction_id")
  requestedAt         DateTime     @default(now()) @map("requested_at")
  processedAt         DateTime?    @map("processed_at")

  payment Payment @relation(fields: [paymentId], references: [paymentId])

  @@index([paymentId])
  @@map("refunds")
}

model OrderStatusHistory {
  historyId       String      @id @default(uuid()) @map("history_id")
  orderId         String      @map("order_id")
  status          OrderStatus
  changedByUserId String?     @map("changed_by_user_id")
  changedAt       DateTime    @default(now()) @map("changed_at")
  notes           String?

  order         Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  changedByUser User? @relation("OrderStatusChangedBy", fields: [changedByUserId], references: [userId])

  @@index([orderId])
  @@map("order_status_history")
}
