# Copy to .env and fill in.
#
# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# Default below assumes a native local PostgreSQL install on the standard
# port 5432, with a "smartprint" database created and a user/password of
# your choosing -- update USERNAME/PASSWORD to match your own install.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/smartprint"

# Alternative: if you'd rather not install Postgres locally, `docker compose
# up db` (see ../docker-compose.yml) starts one for you with user/password
# "smartprint" on host port 5433 -- use that instead in your own .env:
#   DATABASE_URL="postgresql://smartprint:smartprint@localhost:5433/smartprint"
# NOTE: port 5433 is a common default for "the other Postgres container" on
# a dev machine -- if you already run a different project's DB there, either
# stop it first or change the host-side port mapping in docker-compose.yml.

# Server
PORT=4321
NODE_ENV=development

# Auth
# Any random string works for local dev -- it just needs to be non-empty.
JWT_SECRET=dev-secret-change-in-production
# Access token lifetime. Short on purpose: the browser quietly gets a new one
# using the refresh cookie below, so users are not asked to log in again.
JWT_EXPIRES_IN=15m
# How long a login stays alive without the user coming back (days).
REFRESH_TOKEN_TTL_DAYS=7
# lax is right when frontend and API share a site (dev proxy, or one domain).
# Use none only if the frontend is on a different site (needs HTTPS).
REFRESH_COOKIE_SAMESITE=lax
ALLOWED_STUDENT_EMAIL_DOMAIN=thapar.edu

# Documents
UPLOAD_DIR=uploads/documents
MAX_FILE_SIZE_MB=25

# Payments: mock (simulated, default for development) or razorpay.
# For Razorpay test mode, create a free account at razorpay.com, switch the
# dashboard to Test Mode and generate API keys. Test keys (rzp_test_...) never
# move real money. Keep the real values in your untracked .env only.
# Locally the webhook is optional (Razorpay cannot reach localhost anyway).
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Where files are stored: local (UPLOAD_DIR above, the default) or s3 (a
# Cloudflare R2 / AWS S3 bucket). For s3, fill in the S3_* values; keep the
# real keys only in your untracked .env. See README.md "File storage".
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Word/Excel/PowerPoint -> PDF for printing, using LibreOffice. If LibreOffice
# is not installed the upload still works (no PDF copy). On Windows set
# SOFFICE_PATH="C:\Program Files\LibreOffice\program\soffice.exe".
OFFICE_CONVERSION_ENABLED=true
SOFFICE_PATH=
OFFICE_CONVERSION_TIMEOUT_SECONDS=60
OFFICE_CONVERSION_MAX_PARALLEL=2

# Automatic file deletion. Files are removed this many hours after every order
# using them is collected or cancelled, and never-used uploads after
# UNUSED_DOCUMENT_RETENTION_HOURS. Interval 0 turns the job off.
FILE_CLEANUP_INTERVAL_MINUTES=60
FINISHED_ORDER_FILE_RETENTION_HOURS=24
UNUSED_DOCUMENT_RETENTION_HOURS=24

# Frontend URL used to build password-reset links (reset-password?token=...)
# In production this MUST be the public https URL (startup is refused otherwise).
FRONTEND_URL=http://localhost:5173

# Email (password reset). Optional - if any of these are unset, the app
# falls back to logging reset URLs to the server console in development,
# and refuses to start in production (see src/services/email/index.ts).
# EMAIL_PROVIDER is optional: smtp | console | mock. Unset = SMTP when the four
# variables below are all set, otherwise the dev console. console and mock are
# never allowed in production. Any SMTP server works (no paid service needed);
# keep real credentials in your untracked .env, never here.
# See README.md "Password reset and email".
EMAIL_PROVIDER=
EMAIL_FROM="SmartPrint <no-reply@smartprint.dev>"
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# Print assistant (chat). Optional - leave ANTHROPIC_API_KEY empty to use the
# built-in rule-based parser. With a key, the message text is sent to Anthropic.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5

# After `npx prisma migrate dev` + `npx prisma db seed`, log in with any
# seeded account below and password DevPassword123! (see prisma/seed.ts):
#   admin@smartprint.dev      (ADMIN)
#   staff@smartprint.dev      (SHOP_STAFF)
#   faculty@smartprint.dev    (FACULTY)
#   student1@smartprint.dev   (STUDENT)

# Wait-time estimates shown to students. Set to false to switch them off everywhere
# (e.g. if a shop's data looks odd right before a demo). Default: true.
WAIT_ESTIMATES_ENABLED=true
