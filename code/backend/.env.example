# Copy to .env and fill in.
#
# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# Default below assumes a native local PostgreSQL install on the standard
# port 5432, with a "smartprint" database created and a user/password of
# your choosing -- update USERNAME/PASSWORD to match your own install.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartprint"

# Alternative: if you'd rather not install Postgres locally, `docker compose
# up db` (see ../docker-compose.yml) starts one for you with user/password
# "smartprint" on host port 5433 -- use that instead in your own .env:
#   DATABASE_URL="postgresql://smartprint:smartprint@localhost:5433/smartprint"
# NOTE: port 5433 is a common default for "the other Postgres container" on
# a dev machine -- if you already run a different project's DB there, either
# stop it first or change the host-side port mapping in docker-compose.yml.

# Server
PORT=4000
NODE_ENV=development

# Auth
# Any random string works for local dev -- it just needs to be non-empty.
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=1d
ALLOWED_STUDENT_EMAIL_DOMAIN=thapar.edu

# Documents
UPLOAD_DIR=uploads/documents
MAX_FILE_SIZE_MB=25

# Frontend URL used to build password-reset links (reset-password?token=...)
# In production this MUST be the public https URL (startup is refused otherwise).
FRONTEND_URL=http://localhost:5173

# Email (password reset). Optional - if any of these are unset, the app
# falls back to logging reset URLs to the server console in development,
# and refuses to start in production (see src/services/email/index.ts).
EMAIL_FROM="SmartPrint <no-reply@smartprint.dev>"
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# After `npx prisma migrate dev` + `npx prisma db seed`, log in with any
# seeded account below and password DevPassword123! (see prisma/seed.ts):
#   admin@smartprint.dev      (ADMIN)
#   staff@smartprint.dev      (SHOP_STAFF)
#   faculty@smartprint.dev    (FACULTY)
#   student1@smartprint.dev   (STUDENT)
