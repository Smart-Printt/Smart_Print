# Copy to .env.test (git-ignored) and fill in USERNAME/PASSWORD.
#
# Used ONLY by the Jest/Supertest suite (npm test) and the test:db:* scripts.
# Several test files create and delete rows directly, so they must never run
# against the development database: scripts/testDbGuard.ts refuses to run
# unless DATABASE_URL points at database "smartprint_test" on localhost:5432,
# and unless it differs from the database in .env.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/smartprint_test"

# Any non-empty value works - only used to sign tokens inside the test run.
JWT_SECRET=test-secret-change-me
JWT_EXPIRES_IN=1d
ALLOWED_STUDENT_EMAIL_DOMAIN=thapar.edu
