# Template for docker-compose.prod.yml. Copy to .env.production (git-ignored)
# and replace every placeholder. Never commit the real file.

APP_ENV=production

# Database (the db container is created with these)
POSTGRES_USER=smartprint
POSTGRES_PASSWORD=<long random password>
POSTGRES_DB=smartprint

# Long random value, e.g. the output of: openssl rand -hex 48
JWT_SECRET=<long random value>

# Must be a real payment provider - "mock" is refused in production.
PAYMENT_PROVIDER=<real provider, once integrated>

# Public https address of the site (no trailing slash)
FRONTEND_URL=https://smartprint.example.edu
CORS_ALLOWED_ORIGINS=https://smartprint.example.edu

# Number of proxies in front of the backend: nginx + your HTTPS proxy = 2
TRUST_PROXY=2

# Host port for the frontend container (put your HTTPS proxy in front of it)
FRONTEND_PORT=8080

ALLOWED_STUDENT_EMAIL_DOMAIN=thapar.edu

# SMTP for password-reset emails
EMAIL_FROM=SmartPrint <no-reply@smartprint.example.edu>
EMAIL_HOST=<smtp host>
EMAIL_PORT=587
EMAIL_USER=<smtp user>
EMAIL_PASSWORD=<smtp password>
