# Copy to agent.env (git-ignored) and fill in. Then: npm start
#
# Address of the SmartPrint site (no trailing slash).
SMARTPRINT_URL=http://localhost:4000

# A SHOP STAFF account of the shop this PC prints for. Create a separate one
# for the printer (e.g. printer.gblock@...), so its actions show up as the
# printer's in the order history.
AGENT_EMAIL=staff@smartprint.dev
AGENT_PASSWORD=change-me

# How to print:
#   auto    - lp on Linux/macOS, SumatraPDF on Windows
#   lp      - CUPS "lp" command (Linux/macOS)
#   sumatra - SumatraPDF (Windows; free: https://www.sumatrapdfreader.org)
#   folder  - no printer: save each file to OUTPUT_DIR (for demos/testing)
PRINT_METHOD=auto

# Printer name as the computer knows it. Empty = the default printer.
PRINTER_NAME=

# Only for PRINT_METHOD=sumatra, if it is not in the default location.
SUMATRA_PATH=

# Only for PRINT_METHOD=folder.
OUTPUT_DIR=./printed

# How often to check for new orders (seconds).
POLL_SECONDS=10
